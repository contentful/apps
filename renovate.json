{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>contentful/renovate-config:defaultNxMonorepo"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["@contentful/app-sdk"],
      "enabled": false
    },
    {
      "description": "Review rich-text editor, Slate and Plate updates manually for compatibility.",
      "matchFileNames": ["apps/rich-text-versioning/package.json"],
      "matchPackageNames": [
        "@contentful/field-editor-rich-text",
        "slate",
        "slate-*",
        "@udecode/slate",
        "@udecode/slate-*",
        "@udecode/plate",
        "@udecode/plate-*",
        "platejs",
        "@platejs/*"
      ],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "production dependencies",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies",
      "automerge": false
    }
  ]
}
