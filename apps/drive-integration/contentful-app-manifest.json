{
  "name": "Drive Integration",
  "description": "Sync your Contentful content with Drive Integration",
  "id": "google-docs",
  "category": "Productivity",
  "version": "0.1.0",
  "locations": [
    {
      "location": "app-config",
      "component": "ConfigScreen"
    }
  ],
  "functions": [
    {
      "id": "initiateGdocOauth",
      "name": "Initiate Gdoc OAuth Flow",
      "description": "Initiates the OAuth flow for Drive Integration",
      "path": "functions/oauth/initiateOauth.js",
      "entryFile": "functions/oauth/initiateOauth.ts",
      "allowNetworks": ["oauth2.googleapis.com"],
      "accepts": ["appaction.call"]
    },
    {
      "id": "completeGdocOauth",
      "name": "Complete Gdoc OAuth Flow",
      "description": "Completes the OAuth flow for Drive Integration",
      "path": "functions/oauth/completeOauth.js",
      "entryFile": "functions/oauth/completeOauth.ts",
      "allowNetworks": ["oauth2.googleapis.com"],
      "accepts": ["appaction.call"]
    },
    {
      "id": "revokeGdocOauthToken",
      "name": "Revoke Gdoc OAuth Token",
      "description": "Revoke token for the Drive Integration app to disconnect from the app",
      "path": "functions/oauth/disconnect.js",
      "entryFile": "functions/oauth/disconnect.ts",
      "allowNetworks": ["oauth2.googleapis.com"],
      "accepts": ["appaction.call"]
    },
    {
      "id": "checkGdocOauthTokenStatus",
      "name": "Check Gdoc OAuth Token Status",
      "description": "Checks the status of the Drive Integration OAuth token to see if it is valid",
      "path": "functions/oauth/checkStatus.js",
      "entryFile": "functions/oauth/checkStatus.ts",
      "allowNetworks": ["oauth2.googleapis.com"],
      "accepts": ["appaction.call"]
    },
    {
      "id": "recordRun",
      "name": "Record Run",
      "description": "Records a run in the database",
      "path": "functions/storage/recordRun.js",
      "entryFile": "functions/storage/recordRun.ts",
      "accepts": ["appaction.call"]
    },
    {
      "id": "removeRun",
      "name": "Remove Run",
      "description": "Removes a run from the database",
      "path": "functions/storage/removeRun.js",
      "entryFile": "functions/storage/removeRun.ts",
      "accepts": ["appaction.call"]
    },
    {
      "id": "updateRun",
      "name": "Update Run",
      "description": "Updates a run in the database",
      "path": "functions/storage/updateRun.js",
      "entryFile": "functions/storage/updateRun.ts",
      "accepts": ["appaction.call"]
    },
    {
      "id": "listRuns",
      "name": "List Runs",
      "description": "Lists all runs in the database",
      "path": "functions/storage/listRuns.js",
      "entryFile": "functions/storage/listRuns.ts",
      "accepts": ["appaction.call"]
    }
  ],
  "actions": [
    {
      "name": "Initiate Gdoc OAuth Flow",
      "category": "Custom",
      "description": "Initiates the OAuth flow for Drive Integration",
      "type": "function-invocation",
      "functionId": "initiateGdocOauth",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    },
    {
      "name": "Complete Gdoc OAuth Flow",
      "category": "Custom",
      "description": "Completes the OAuth flow for Drive Integration",
      "type": "function-invocation",
      "functionId": "completeGdocOauth",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    },
    {
      "name": "Revoke Gdoc OAuth Token",
      "category": "Custom",
      "description": "Revoke token for the Drive Integration app to disconnect from the app",
      "type": "function-invocation",
      "functionId": "revokeGdocOauthToken",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    },
    {
      "name": "Check Gdoc OAuth Token Status",
      "category": "Custom",
      "description": "Checks the status of the Drive Integration OAuth token to see if it is valid",
      "type": "function-invocation",
      "functionId": "checkGdocOauthTokenStatus",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    },
    {
      "name": "Record Run",
      "category": "Custom",
      "description": "Records a run in the database",
      "type": "function-invocation",
      "functionId": "recordRun",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    },
    {
      "name": "Remove Run",
      "category": "Custom",
      "description": "Removes a run from the database",
      "type": "function-invocation",
      "functionId": "removeRun",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    },
    {
      "name": "Update Run",
      "category": "Custom",
      "description": "Updates a run in the database",
      "type": "function-invocation",
      "functionId": "updateRun",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    },
    {
      "name": "List Runs",
      "category": "Custom",
      "description": "Lists all runs in the database",
      "type": "function-invocation",
      "functionId": "listRuns",
      "parametersSchema": {
        "type": "object"
      },
      "resultSchema": {
        "type": "object"
      }
    }
  ],
  "storage": {
    "version": 1,
    "namespace": "driveIntegration",
    "functions": ["recordRun", "removeRun", "updateRun", "listRuns"],
    "tables": [
      {
        "name": "runs",
        "columns": [
          { "name": "runId", "type": "text", "nullable": false, "index": true },
          { "name": "documentTitle", "type": "text", "nullable": false },
          { "name": "documentId", "type": "text", "nullable": false },
          { "name": "contentTypeIds", "type": "json", "nullable": false },
          { "name": "documentSelection", "type": "json", "nullable": false },
          { "name": "startedAt", "type": "text", "nullable": false },
          { "name": "createdEntryIds", "type": "json", "nullable": true }
        ]
      }
    ]
  }
}
