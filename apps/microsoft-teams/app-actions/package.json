    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^10.0.20",
    "@types/sinon-chai": "^3.2.12",
    "botbuilder": "^4.23.3",
    "chai": "^4.5.0",
    "sinon-chai": "^3.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
