{
  "name": "ai-content-generator",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@contentful/app-scripts": "^2.3.0",
    "@contentful/app-sdk": "4.23.0",
    "@contentful/f36-components": "4.67.0",
    "@contentful/f36-icons": "^4.27.0",
    "@contentful/f36-tokens": "4.0.5",
    "@contentful/node-apps-toolkit": "^3.11.1",
    "@contentful/react-apps-toolkit": "1.2.16",
    "@contentful/rich-text-plain-text-renderer": "^16.0.5",
    "@emotion/react": "^11.11.1",
    "@segment/analytics-next": "^1.55.0",
    "contentful-management": "11.14.0",
    "openai": "^4.68.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "usehooks-ts": "^2.9.1"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "@originjs/vite-plugin-commonjs>esbuild": true,
      "vite>esbuild": true
    }
  },
  "scripts": {
    "allow-scripts": "allow-scripts run",
    "start": "vite",
    "start:dev": "NODE_ENV='development' && npm start",
    "start:preview": "npm run build && vite preview",
    "start:staging": "NODE_ENV='staging' && npm run start:preview",
    "start:prod": "NODE_ENV='production' && npm run start:preview",
    "build": "tsc && vite build --mode ${NODE_ENV:='production'} && npm run build:functions && cp -r build/functions dist/functions",
    "build:functions": "contentful-app-scripts build-functions --ci",
    "test": "vitest --logHeapUsage --coverage",
    "test:ci": "vitest",
    "lint": "eslint src --max-warnings 0",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "deploy": "contentful-app-scripts upload --ci --bundle-dir ./dist --organization-id ${DEFINITIONS_ORG_ID} --definition-id ${DEFINITIONS_APP_DEF_ID} --token ${CONTENTFUL_CMA_TOKEN} && npm run upsert-actions",
    "upsert-actions": "contentful-app-scripts upsert-actions --organization-id ${DEFINITIONS_ORG_ID} --definition-id ${DEFINITIONS_APP_DEF_ID} --token ${CONTENTFUL_CMA_TOKEN}"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^3.4.3",
    "@lavamoat/preinstall-always-fail": "^1.0.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@testing-library/react": "14.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "18.0.3",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "@vitejs/plugin-react": "4.0.4",
    "@vitest/coverage-v8": "0.34.6",
    "eslint": "^8.46.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "20.0.2",
    "typescript": "4.7.4",
    "vite": "4.5.14",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "0.34.6"
  },
  "overrides": {
    "form-data": "^4.0.4"
  }
}
