{
  "functions": [
    {
      "id": "validateMarketoCredentialsFunction",
      "name": "Validate Marketo credentials",
      "description": "Validates Marketo client ID, secret and Munchkin ID via identity endpoint",
      "path": "functions/validateMarketoCredentials.js",
      "entryFile": "functions/validateMarketoCredentials.ts",
      "allowNetworks": ["https://*.mktorest.com"],
      "accepts": ["appaction.call"]
    },
    {
      "id": "getMarketoFormsFunction",
      "name": "Get Marketo forms",
      "description": "Function to get Marketo forms from an App Action",
      "path": "functions/getMarketoForms.js",
      "entryFile": "functions/getMarketoForms.ts",
      "allowNetworks": ["https://*.mktorest.com"],
      "accepts": ["appaction.call"]
    },
    {
      "id": "getMarketoFolderStatusFunction",
      "name": "Get Marketo folder status",
      "description": "Function to get the archive status of Marketo folders from an App Action",
      "path": "functions/getMarketoFolderStatus.js",
      "entryFile": "functions/getMarketoFolderStatus.ts",
      "allowNetworks": ["https://*.mktorest.com"],
      "accepts": ["appaction.call"]
    }
  ],
  "actions": [
    {
      "id": "validateMarketoCredentialsAction",
      "name": "Validate Marketo credentials",
      "type": "function-invocation",
      "functionId": "validateMarketoCredentialsFunction",
      "category": "Custom",
      "parameters": [
        {
          "id": "clientId",
          "name": "Client ID",
          "type": "Symbol",
          "required": false
        },
        {
          "id": "clientSecret",
          "name": "Client Secret",
          "type": "Symbol",
          "required": false
        },
        {
          "id": "munchkinId",
          "name": "Munchkin ID",
          "type": "Symbol",
          "required": false
        }
      ]
    },
    {
      "id": "getMarketoFormsAction",
      "name": "Get Marketo forms",
      "type": "function-invocation",
      "functionId": "getMarketoFormsFunction",
      "category": "Custom",
      "parameters": [
        {
          "id": "offset",
          "name": "Offset",
          "type": "Number",
          "required": false
        }
      ],
      "resultSchema": {
        "type": "object",
        "properties": {
          "forms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The ID of the form"
                },
                "url": {
                  "type": "string",
                  "description": "The URL of the form"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the form"
                },
                "folder": {
                  "type": "object",
                  "description": "The folder or program the form lives in",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "type": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "nextOffset": {
            "type": "number",
            "description": "Offset of the next page of forms; absent on the last page"
          },
          "rateLimited": {
            "type": "boolean",
            "description": "Marketo rate limited the call; retry after a wait"
          }
        }
      }
    },
    {
      "id": "getMarketoFolderStatusAction",
      "name": "Get Marketo folder status",
      "type": "function-invocation",
      "functionId": "getMarketoFolderStatusFunction",
      "category": "Custom",
      "parameters": [
        {
          "id": "folders",
          "name": "Folders",
          "type": "Symbol",
          "required": true
        }
      ],
      "resultSchema": {
        "type": "object",
        "properties": {
          "folders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number"
                },
                "type": {
                  "type": "string"
                },
                "isArchive": {
                  "type": "boolean"
                }
              }
            }
          },
          "rateLimited": {
            "type": "boolean",
            "description": "Some folders were rate limited; retry them after a wait"
          }
        }
      }
    }
  ]
}
