{
  "name": "adobe-marketo-form-selector",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "dependencies": {
    "@contentful/app-sdk": "4.51.0",
    "@contentful/f36-components": "5.6.0",
    "@contentful/f36-tokens": "5.1.0",
    "@contentful/react-apps-toolkit": "1.2.16",
    "@testing-library/jest-dom": "^6.9.1",
    "contentful-management": "11.62.0",
    "emotion": "10.0.27",
    "happy-dom": "^20.4.0",
    "prettier": "^3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build && npm run build:functions",
    "test": "vitest",
    "test:ci": "vitest run",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "add-locations": "contentful-app-scripts add-locations",
    "upload": "contentful-app-scripts upload --bundle-dir ./build",
    "upload-ci": "contentful-app-scripts upload --ci --bundle-dir ./build --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN",
    "deploy": "contentful-app-scripts upload --ci --bundle-dir ./build --organization-id ${DEFINITIONS_ORG_ID} --definition-id 6ISjWBCsHWLLhMnh17H7GH --token ${CONTENTFUL_CMA_TOKEN} && npm run upsert-actions:prd",
    "deploy:test": "contentful-app-scripts upload --ci --bundle-dir ./build --organization-id ${DEV_TESTING_ORG_ID} --definition-id 4qAPTz2bPan21spds6Ur25 --token ${TEST_CMA_TOKEN} && npm run upsert-actions:test",
    "lint": "eslint . ",
    "lint:write": "eslint .  --fix",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "prettier:list": "prettier -l .",
    "upsert-actions": "contentful-app-scripts upsert-actions --ci --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN",
    "upsert-actions:prd": "contentful-app-scripts upsert-actions --ci --organization-id ${DEFINITIONS_ORG_ID} --definition-id 6ISjWBCsHWLLhMnh17H7GH --token ${CONTENTFUL_CMA_TOKEN}",
    "upsert-actions:test": "contentful-app-scripts upsert-actions --ci --organization-id ${DEV_TESTING_ORG_ID} --definition-id 4qAPTz2bPan21spds6Ur25 --token ${TEST_CMA_TOKEN}",
    "upsert-actions:dev": "source .env && contentful-app-scripts upsert-actions --ci --organization-id \"$CONTENTFUL_ORG_ID\" --definition-id \"$CONTENTFUL_APP_DEF_ID\" --token \"$CONTENTFUL_ACCESS_TOKEN\"",
    "build:functions": "contentful-app-scripts build-functions --ci"
  },
  "devDependencies": {
    "@contentful/app-scripts": "^2.5.12",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "1.2.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "25.1.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "7.2.0",
    "vitest": "4.1.12",
    "@contentful/node-apps-toolkit": "^3.16.1",
    "@tsconfig/recommended": "1.0.13"
  }
}
