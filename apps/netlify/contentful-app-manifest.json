{
  "functions": [
    {
      "id": "appEventHandler",
      "name": "Netlify build on content events",
      "description": "Fires the configured Netlify build hooks when entries or assets are published or unpublished.",
      "path": "functions/appEventHandler.js",
      "entryFile": "functions/appEventHandler.js",
      "allowNetworks": [
        "api.netlify.com"
      ],
      "accepts": [
        "appevent.handler"
      ]
    },
    {
      "id": "handleBuildHook",
      "name": "App Action Function Template",
      "description": "Template for creating custom app actions. Add your own code to define how your app should respond when an action is triggered.",
      "path": "functions/handleBuildHook.js",
      "entryFile": "functions/handleBuildHook.ts",
      "allowNetworks": ["api.netlify.com"],
      "accepts": [
        "appaction.call"
      ]
    }
  ],
  "actions": [
    {
      "id": "netlifyBuild",
      "name": "Netlify build",
      "type": "function-invocation",
      "functionId": "handleBuildHook",
      "category": "Custom",
      "parameters": [
        {
          "id": "siteName",
          "name": "Site name",
          "type": "Symbol",
          "required": true
        }
      ]
    }
  ]
}